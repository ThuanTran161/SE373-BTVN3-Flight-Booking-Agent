# LLM Provider configuration:"google" or "openai"
LLM_PROVIDER=google

# Google Gemini API Key (if using google)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API Key (if using openai)
OPENAI_API_KEY=your_openai_api_key_here

# Model name configuration (optional overrides)
# Google default: gemini-1.5-flash or gemini-2.0-flash
# OpenAI default: gpt-4o-mini or gpt-4o
MODEL_NAME=gemini-2.0-flash
